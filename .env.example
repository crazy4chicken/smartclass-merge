# smartclass-merge configuration.
#
# Copy to .env (or any file) and point MERGE_ENV_FILE at it; the process
# reads the file only when that variable is set. Real environment variables
# always win over file values, and file values win over the defaults below.
# Never commit a filled-in copy: MERGE_DSN and every *_SECRET are secrets.

# Trigger: path of a .env-style file loaded at startup. Unset by default.
# MERGE_ENV_FILE=/etc/merge/merge.env

# HTTP listen address. Default: :8083
MERGE_LISTEN_ADDR=:8083

# PostgreSQL DSN (required by `run` and `migrate`). The pool sets application_name=smartclass-merge and
# pins search_path to the project schema smartclass_merge; `migrate` and `run`
# create that schema when it is missing, so no object is ever created in the
# database's public schema.
MERGE_DSN=postgres://merge:change-me@127.0.0.1:5432/smartclass?sslmode=disable

# teamusers base URL; JWKS is discovered at {url}/.well-known/jwks.json.
# Used by `run` for token verification and permission lookups. Default: http://127.0.0.1:8082
MERGE_TEAMUSERS_URL=http://127.0.0.1:8082

# Expected JWT issuer claim. Default: teamusers
MERGE_TEAMUSERS_ISSUER=teamusers

# Expected JWT audience claim. Default: teamusers
# Set it to the fleet value (TEAMUSERS_TOKEN_AUDIENCE, e.g. nekostick).
MERGE_TEAMUSERS_AUD=teamusers

# teamusers client-credentials credential (required by `run` unless
# MERGE_DEV=true): used for permission lookups and for the outbound filehouse
# calls, which carry a service token. Both must be set.
MERGE_TEAMUSERS_CLIENT_ID=merge-svc
MERGE_TEAMUSERS_CLIENT_SECRET=change-me

# teamusers admin bearer token used by `register-permissions` when -token is not
# given. A secret: leave it unset here and export it for the one run that
# registers the catalog.
# MERGE_TEAMUSERS_ADMIN_TOKEN=

# IAM HTTP timeout. Default: 5s
MERGE_TEAMUSERS_TIMEOUT=5s

# filehouse (object storage) base URL, e.g. http://filehouse:8080. Required by
# `run` unless MERGE_DEV=true: it is where every segment is read from and the
# merged object is written to.
MERGE_FILEHOUSE_URL=http://127.0.0.1:8080

# Outbound HTTP timeout for filehouse metadata calls (list, start/complete
# multipart); data transfers run under the job context and MERGE_JOB_TIMEOUT
# instead. Default: 30s
MERGE_FILEHOUSE_TIMEOUT=30s

# Bucket segments are read from when a request names none. Default: webcam-segments
MERGE_SOURCE_BUCKET=webcam-segments

# Bucket merged objects are written to (required). A request may override it,
# but there is no sensible default: the merged video does not belong next to
# the raw segments.
MERGE_DEST_BUCKET=recordings

# Size limit for a single stored object. Above it the upload goes through
# multipart, which is not bound by the direct-PUT cap. Default: 5368709120 (5 GiB)
MERGE_OBJECT_MAX_BYTES=5368709120

# Multipart part size. Larger parts are fewer requests; too large a part is
# buffered whole before it is sent. Default: 67108864 (64 MiB), maximum 268435456 (256 MiB)
MERGE_MULTIPART_PART_BYTES=67108864

# Frame rate assumed when a request declares none: the stored bitstream has no
# timing of its own. Valid range 1..240. Default: 25
MERGE_DEFAULT_FPS=25

# Scratch directory for the merged video and the extracted ffmpeg binary.
# Default: <os temp dir>/smartclass-merge
MERGE_WORK_DIR=

# ffmpeg binary to run. Empty uses the binary embedded in this executable;
# set it to a host ffmpeg during development.
MERGE_FFMPEG_PATH=

# Jobs one instance merges at once. Merging is CPU and disk bound; raise it only
# on a host sized for it. Default: 1
MERGE_MAX_CONCURRENT_JOBS=1

# Scheduler scan interval: how often due jobs are claimed. Default: 5s
MERGE_SCHED_TICK=5s

# Lease a claim holds a job for. A worker that dies without failing the job has
# its lease expire and the job claimed again. Default: 2m
MERGE_JOB_LEASE=2m

# Attempts a job gets in total, including the first. Default: 3
MERGE_MAX_ATTEMPTS=3

# Base retry backoff: a job requeued after a failure waits backoff x attempts
# before it is claimed again. Default: 1m
MERGE_RETRY_BACKOFF=1m

# Wall-clock limit for one job, ffmpeg and upload included. Default: 6h
MERGE_JOB_TIMEOUT=6h

# Rerun a failed stream copy as a libx264 transcode. Default: true
# Left on, a codec the copy path cannot mux still produces a video; turned off,
# such a job fails instead of spending CPU on a re-encode.
MERGE_TRANSCODE_FALLBACK=true

# Dev bypass: synthetic claims, teamusers disabled. Default: false
# Local development only; never enable it on a reachable host.
MERGE_DEV=false

# slog level: debug | info | warn | error. Default: info
MERGE_LOG_LEVEL=info
